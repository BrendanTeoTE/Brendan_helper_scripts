rule prepare_mash_dir:
    input:
        skani_done = "flags/skani.{sample}.{short_gb}.{long_gb}.step3.done"
    output:
        done = touch("flags/mash.{sample}.{short_gb}.{long_gb}.prepared.done")
    params:
        src = lambda wc: f"{config[wc.sample]['outdir']}/{wc.short_gb}_{wc.long_gb}_skani",
        dst = lambda wc: f"{config[wc.sample]['outdir']}/{wc.short_gb}_{wc.long_gb}_mash"
    run:
        import os
        os.makedirs(os.path.join(params.dst, "intermediate_files"), exist_ok=True)
        shell(r"""
            set -euo pipefail

            # Link the required OPERA-MS intermediates from SKANI into the new MASH outdir
            for d in coverage_estimation hierarchical_clustering lib_1_bundles opera_long_read read_mapping; do
                srcd="{params.src}/intermediate_files/$d"
                dstd="{params.dst}/intermediate_files/$d"
                if [ -d "$srcd" ]; then
                    # Remove any existing file/dir/link at destination, then make a fresh symlink
                    rm -rf "$dstd" 2>/dev/null || true
                    ln -sfn "$srcd" "$dstd"
                fi
            done

            # Link the timing log if present
            if [ -f "{params.src}/intermediate_files/time.log" ]; then
                ln -sfn "{params.src}/intermediate_files/time.log" "{params.dst}/intermediate_files/time.log"
            fi
        """)


rule step4:
    input:
        preflag = pre_step4_flag,
        short_r1 = get_short_r1,
        short_r2 = get_short_r2,
        long_reads = get_long_read,
        contigs = rules.step1.output['contigs']
    output:
        done = touch("flags/{dist_est}.{sample}.{short_gb}.{long_gb}.step4.done")
    benchmark: "benchmarks/{dist_est}.{sample}.{short_gb}.{long_gb}.step4.extended.txt"
    log: "logs/{dist_est}.{sample}.{short_gb}.{long_gb}.step4.txt"
    params:
        exe = EXECUTOR,
        src = lambda wc: config[wc.sample]["source_dir"],
        outdir = outdir,
        dist = dist_flag
    threads: 32
    shell: r"""
        perl {params.src}/{params.exe}.pl \
            --short-read1 {input.short_r1} \
            --short-read2 {input.short_r2} \
            --long-read {input.long_reads} \
            --contig-file {input.contigs} \
            --out-dir {params.outdir} \
            {params.dist} \
            --num-processors {threads} \
            --step 4 \
            > {log} 2>&1
    """

